# ============================================
# AI-Native IM Environment Configuration
# ============================================

# Database Configuration
DB_PASSWORD=change_this_secure_password
DATABASE_URL=postgresql://prod_user:${DB_PASSWORD}@postgres:5432/ai_im_prod

# Redis Configuration
REDIS_PASSWORD=change_this_redis_password
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379

# Qdrant Vector Database
QDRANT_URL=http://qdrant:6333

# JWT Configuration
JWT_SECRET=change_this_to_a_long_random_string_at_least_32_characters
JWT_ACCESS_TOKEN_EXPIRY=3600        # 1 hour in seconds
JWT_REFRESH_TOKEN_EXPIRY=2592000   # 30 days in seconds

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
RUST_LOG=info
RUST_BACKTRACE=1

# Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password
SMTP_FROM=noreply@yourdomain.com

# Storage Configuration
STORAGE_PROVIDER=local              # Options: local, s3, minio, cloudflare, tencent, aliyun
STORAGE_PATH=/app/uploads           # For local storage

# AWS S3 Configuration (if STORAGE_PROVIDER=s3)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
S3_BUCKET=your-bucket-name
S3_ENDPOINT=                        # Optional, for S3-compatible services

# MinIO Configuration (if STORAGE_PROVIDER=minio)
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ai-im-media

# CloudFlare R2 Configuration (if STORAGE_PROVIDER=cloudflare)
CLOUDFLARE_ACCOUNT_ID=your_account_id
CLOUDFLARE_ACCESS_KEY_ID=your_access_key
CLOUDFLARE_SECRET_ACCESS_KEY=your_secret_key
CLOUDFLARE_BUCKET=your-bucket-name

# Tencent COS Configuration (if STORAGE_PROVIDER=tencent)
TENCENT_SECRET_ID=your_secret_id
TENCENT_SECRET_KEY=your_secret_key
TENCENT_REGION=ap-guangzhou
TENCENT_BUCKET=your-bucket-name

# Aliyun OSS Configuration (if STORAGE_PROVIDER=aliyun)
ALIYUN_ACCESS_KEY_ID=your_access_key_id
ALIYUN_ACCESS_KEY_SECRET=your_access_key_secret
ALIYUN_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
ALIYUN_BUCKET=your-bucket-name

# AI Configuration
OPENAI_API_KEY=sk-your-openai-api-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
GOOGLE_API_KEY=your-google-api-key
SILICONFLOW_API_KEY=your-siliconflow-key

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_SECOND=100
RATE_LIMIT_BURST=200

# WebSocket Configuration
WS_MAX_CONNECTIONS_PER_USER=5
WS_PING_INTERVAL=30                 # seconds
WS_TIMEOUT=300                      # seconds

# Media Processing
MAX_UPLOAD_SIZE=104857600           # 100MB in bytes
IMAGE_MAX_WIDTH=4096
IMAGE_MAX_HEIGHT=4096
VIDEO_MAX_DURATION=600              # 10 minutes in seconds

# Monitoring
GRAFANA_USER=admin
GRAFANA_PASSWORD=change_this_grafana_password

# Security
BCRYPT_COST=12                      # Higher = more secure but slower
CORS_ALLOWED_ORIGINS=*              # Comma-separated list or * for all

# Feature Flags
ENABLE_REGISTRATION=true
ENABLE_EMAIL_VERIFICATION=false
ENABLE_AI_AGENTS=true
ENABLE_MEDIA_PROCESSING=true
ENABLE_MALWARE_SCANNING=false

# Development/Debug
DEBUG=false
ENABLE_QUERY_LOGGING=false
