# ==============================================================================
# 换行符与二进制文件处理
#
# 仓库内统一以 LF 存储；检出时按文件类型还原，避免 Windows / Linux 协作时
# 出现整文件级别的换行符 diff。
# ==============================================================================

* text=auto

# Windows 脚本必须为 CRLF，否则 cmd / PowerShell 可能解析异常
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Unix 脚本必须为 LF，否则在 Linux / macOS 上无法执行
*.sh   text eol=lf
*.bash text eol=lf

# 二进制资源：禁止换行归一化，禁止文本 diff
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
*.pdf   binary
*.mp4   binary
*.mov   binary
*.jar   binary
*.exe   binary
*.dll   binary
*.so    binary
*.dylib binary

# 锁文件不做换行归一化，避免无意义 diff
Cargo.lock   -text
pubspec.lock -text
