# AI Native IM Server Configuration
#
# 注意：本文件是开发期配置模板，部分变量（如 ADMIN_EMAIL / ADMIN_PASSWORD）
# 未被当前代码读取；STORAGE_* 配置块存在重复；COS / OSS provider 为占位实现。
# 项目已归档，请勿将本模板或其默认值用于生产环境。

# ====================
# 基础配置
# ====================

# 运行环境 (development/production/staging)
APP_ENV=development

# 服务器配置
SERVER_HOST=0.0.0.0
PORT=8080
RUST_LOG=debug

# 数据库连接（请修改用户名/密码）
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/ai_im

# Redis 连接
REDIS_URL=redis://localhost:6379

# Qdrant (向量数据库)
QDRANT_URL=http://localhost:6334

# JWT 配置
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-32chars
JWT_ACCESS_EXPIRY=900                      # 15 minutes
JWT_REFRESH_EXPIRY=604800                    # 7 days

# 嵌入维度
EMBEDDING_DIMENSION=1024

# ====================
# AI 服务配置
# ====================

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-sonnet-20240229

# Google Gemini
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-pro

# SiliconFlow (推荐，性价比高)
SILICONFLOW_API_KEY=sk-...
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V3.2
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
SILICONFLOW_VISION_MODEL=Qwen/Qwen2-VL-7B-Instruct

# 默认 LLM 提供商
DEFAULT_LLM_PROVIDER=siliconflow

# 视觉理解
ENABLE_VISION=true

# STT/TTS (语音)
STT_PROVIDER=whisper
TTS_PROVIDER=edge

# ====================
# 安全配置
# ====================

# 文件上传安全
MAX_FILE_SIZE=536870912                      # 512MB
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx,txt,zip,rar,mp4,avi,mov,mp3,wav
SECURITY_SCAN_ENABLED=true
QUARANTINE_ENABLED=true

# 访问控制
ACCESS_CONTROL_ENABLED=true
DEFAULT_FILE_PERMISSION=read
SECURE_URL_EXPIRY=3600                   # 1 hour

# 权限管理
RBAC_ENABLED=true

# ====================
# 存储配置
# ====================

# 主存储提供商（当前代码仅保留占位实现：tencent_cos / aliyun_oss；
# 实际媒体接口使用本地 STORAGE_PATH，云存储上传不可用）
STORAGE_PROVIDER=rustfs

# RustFS 配置 (本地文件系统)
RUSTFS_BASE_PATH=./storage
RUSTFS_CREATE_DIRS=true
RUSTFS_FILE_PERMISSIONS=644
RUSTFS_ENABLE_DEDUPLICATION=true
RUSTFS_METADATA_CACHE_TTL=300
RUSTFS_MAX_CONCURRENT_OPS=100
RUSTFS_IO_BUFFER_SIZE=65536
RUSTFS_CHUNK_SIZE=8388608

# S3/MinIO 通用配置
STORAGE_ACCESS_KEY=your-access-key
STORAGE_SECRET_KEY=your-secret-key
STORAGE_REGION=us-east-1
STORAGE_BUCKET=ai-im-files
STORAGE_ENDPOINT=                          # 自定义端点 (可选)
STORAGE_PRESIGNED_URL_EXPIRY=3600         # 1 hour

# AWS S3 特定配置
# STORAGE_SESSION_TOKEN=your-session-token

# Cloudflare R2
CLOUDFLARE_ACCOUNT_ID=your-account-id

# CDN 配置
CDN_PROVIDER=none                            # none/cloudflare/cloudfront
CDN_DOMAIN=

# 加密配置
STORAGE_ENABLE_ENCRYPTION=true

# ====================
# 缓存配置
# ====================

# Redis 缓存
CACHE_REDIS_ENABLED=true
CACHE_REDIS_TTL=3600                       # 1 hour
CACHE_REDIS_MAX_CONNECTIONS=20
CACHE_REDIS_MIN_IDLE_CONNECTIONS=5

# 内存缓存
CACHE_MEMORY_SIZE=1000
CACHE_MEMORY_TTL=300                         # 5 minutes

# 缓存策略
CACHE_STRATEGY=lru
CACHE_WARMUP_ENABLED=true
CACHE_WARMUP_CONCURRENT=10

# ====================
# 性能配置
# ====================

# 连接池
POOL_MIN_SIZE=5
POOL_MAX_SIZE=20
POOL_CONNECTION_TIMEOUT=30                # seconds
POOL_IDLE_TIMEOUT=600                     # seconds
POOL_MAX_LIFETIME=1800                   # seconds

# 性能监控
PERFORMANCE_MONITORING_ENABLED=true
METRICS_COLLECTION_INTERVAL=30             # seconds
PERFORMANCE_TUNING_ENABLED=true
OPTIMIZATION_STRATEGY=moderate             # conservative/moderate/aggressive

# ====================
# 任务队列配置
# ====================

TASK_QUEUE_ENABLED=true
TASK_QUEUE_RETRY_ATTEMPTS=3
TASK_QUEUE_TIMEOUT=60                         # seconds
TASK_QUEUE_BATCH_SIZE=10
TASK_QUEUE_WORKER_COUNT=4

# 任务调度
TASK_SCHEDULER_ENABLED=true
TASK_SCHEDULER_POOL_SIZE=4

# ====================
# 预览生成配置
# ====================

PREVIEW_ENABLED=true
PREVIEW_MAX_FILE_SIZE=536870912            # 512MB
PREVIEW_TIMEOUT=60                           # seconds
PREVIEW_THUMBNAIL_SIZES=150,300,600
PREVIEW_CACHE_ENABLED=true

# 支持的预览类型
PREVIEW_IMAGE_FORMATS=jpg,jpeg,png,gif,webp,bmp
PREVIEW_DOCUMENT_FORMATS=pdf,doc,docx,txt,md
PREVIEW_VIDEO_FORMATS=mp4,avi,mov,mkv
PREVIEW_AUDIO_FORMATS=mp3,wav,flac,aac

# ====================
# 管理仪表盘配置
# ====================

ADMIN_DASHBOARD_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=90
ALERT_EMAIL_ENABLED=false
SYSTEM_SNAPSHOT_ENABLED=true
CONFIG_BACKUP_ENABLED=true

# 管理员配置（当前代码未读取，仅作历史配置保留）
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# ====================
# 配额管理
# ====================

DEFAULT_DAILY_TOKEN_LIMIT=100000
DEFAULT_MONTHLY_TOKEN_LIMIT=3000000
DEFAULT_DAILY_STT_SECONDS=600
DEFAULT_DAILY_TTS_SECONDS=600

# ====================
# 主动消息配置
# ====================

PROACTIVE_SILENCE_THRESHOLD_MINUTES=120
PROACTIVE_COOLDOWN_MINUTES=60
PROACTIVE_DAILY_LIMIT=5

# ====================
# 学习引擎配置
# ====================

LEARNING_ENABLED=true
LEARNING_REVIEW_THRESHOLD=3
LEARNING_ANONYMIZE_DATA=true

# ====================
# 限流配置
# ====================

API_RATE_LIMIT_PER_MINUTE=100
LOGIN_RATE_LIMIT_PER_15MIN=5
UPLOAD_RATE_LIMIT_PER_MINUTE=10
MESSAGE_RATE_LIMIT_PER_MINUTE=200

# ====================
# 功能开关
# ====================

ENABLE_METRICS_EXPORT=true
ENABLE_HEALTH_CHECK=true
ENABLE_AUTO_OPTIMIZATION=true
ENABLE_PERSISTENT_CACHE=true
ENABLE_TASK_RETRY=true

# 调试模式
DEBUG_MODE=false
TRACE_REQUESTS=false

# 压力测试模式
STRESS_TEST_MODE=false

# ====================
# 监控和告警
# ====================

# Prometheus 指标
METRICS_ENABLED=true
METRICS_PORT=9090

# 健康检查
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PORT=8081

# 告警配置
ALERT_EMAIL_SMTP_SERVER=smtp.gmail.com
ALERT_EMAIL_SMTP_PORT=587
ALERT_EMAIL_USERNAME=alerts@yourdomain.com
ALERT_EMAIL_PASSWORD=your-email-password
ALERT_EMAIL_FROM=alerts@yourdomain.com

# 告警阈值
CPU_ALERT_THRESHOLD=80                     # %
MEMORY_ALERT_THRESHOLD=85                   # %
DISK_ALERT_THRESHOLD=90                     # %
ERROR_RATE_ALERT_THRESHOLD=5               # %

# ====================
# 存储配置
# ====================

# 存储提供商 (rustfs/s3/cloudflare_r2/tencent_cos/aliyun_oss/minio)
# 推荐使用 rustfs (本地) 或 s3 (生产)
STORAGE_PROVIDER=rustfs

# 存储桶/容器名称
STORAGE_BUCKET=ai-native-im

# 是否使用 SSL (生产环境必须设置为 true)
STORAGE_USE_SSL=true

# 分块大小 (字节，默认 8MB)
STORAGE_CHUNK_SIZE=8388608

# 最大重试次数
STORAGE_MAX_RETRIES=3

# 预签名 URL 过期时间 (秒，默认 1 小时)
STORAGE_PRESIGNED_URL_EXPIRATION=3600

# 启用加密
STORAGE_ENABLE_ENCRYPTION=true

# ====================
# RustFS 配置 (仅当使用 rustfs 时需要)
# ====================

# RustFS 基础路径 (默认 ./storage/bucket-name)
# RUSTFS_BASE_PATH=/mnt/storage/files

# RustFS 挂载路径 (可选，用于 FUSE 挂载)
RUSTFS_MOUNT_PATH=/mnt/files

# 启用文件去重 (推荐启用以节省空间)
RUSTFS_ENABLE_DEDUPLICATION=true

# 元数据缓存 TTL (秒，默认 300)
RUSTFS_METADATA_CACHE_TTL=300

# 最大并发操作数 (默认 100)
RUSTFS_MAX_CONCURRENT_OPS=100

# I/O 缓冲区大小 (字节，默认 64KB)
RUSTFS_IO_BUFFER_SIZE=65536

# 启用压缩 (可选，会增加 CPU 使用)
# RUSTFS_ENABLE_COMPRESSION=false

# 分块大小 (字节，默认 8MB)
RUSTFS_CHUNK_SIZE=8388608

# ====================
# AWS S3 配置 (仅当使用 S3 时需要)
# ====================

# AWS 访问密钥 ID
# STORAGE_ACCESS_KEY=AKIAIOSFODNN7EXAMPLE

# AWS 秘密访问密钥
# STORAGE_SECRET_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# AWS 区域
# STORAGE_REGION=us-east-1

# S3 端点 (可选，用于兼容性服务)
# STORAGE_ENDPOINT=https://s3.amazonaws.com

# AWS 会话令牌 (可选，用于临时凭证)
# STORAGE_SESSION_TOKEN=

# ====================
# Cloudflare R2 配置 (仅当使用 cloudflare_r2 时需要)
# ====================

# Cloudflare 账户 ID
# CLOUDFLARE_ACCOUNT_ID=your-account-id

# R2 访问密钥 ID
# STORAGE_ACCESS_KEY=your-r2-access-key

# R2 秘密访问密钥
# STORAGE_SECRET_KEY=your-r2-secret-key

# ====================
# 腾讯云 COS 配置 (仅当使用 tencent_cos 时需要)
# ====================

# 腾讯云 Secret ID
# STORAGE_SECRET_ID=your-secret-id

# 腾讯云 Secret Key
# STORAGE_SECRET_KEY=your-secret-key

# 腾讯云区域 (默认 ap-beijing)
# STORAGE_REGION=ap-beijing

# ====================
# 阿里云 OSS 配置 (仅当使用 aliyun_oss 时需要)
# ====================

# 阿里云 Access Key ID
# STORAGE_ACCESS_KEY=your-oss-access-key

# 阿里云 Secret Access Key
# STORAGE_SECRET_KEY=your-oss-secret-key

# 阿里云区域 (默认 oss-cn-hangzhou)
# STORAGE_REGION=oss-cn-hangzhou

# ====================
# MinIO 配置 (已弃用，建议迁移到 rustfs 或 S3)
# ====================

# MinIO 访问密钥
# STORAGE_ACCESS_KEY=minioadmin

# MinIO 秘密密钥
# STORAGE_SECRET_KEY=minioadmin123

# MinIO 端点
# STORAGE_ENDPOINT=http://localhost:9000

# ====================
# RustFS 配置 (本地文件系统)
# ====================

# 挂载路径 (可选，默认 /mnt/files)
# RUSTFS_MOUNT_PATH=/mnt/files

# 缓存大小 (可选，默认 1GB)
# RUSTFS_CACHE_SIZE=1073741824

# 最大文件数 (可选，默认 1000000)
# RUSTFS_MAX_FILES=1000000

# ====================
# 日志配置
# ====================

# 日志级别 (trace/debug/info/warn/error)
RUST_LOG=ai_im_server=debug,tower_http=debug,sqlx=warn

# 是否启用结构化日志 JSON (true/false)
# LOG_STRUCTURED=false

# ====================
# 邮件配置 (可选)
# ====================

# SMTP 服务器
# SMTP_SERVER=smtp.gmail.com

# SMTP 端口
# SMTP_PORT=587

# SMTP 用户名
# SMTP_USERNAME=your-email@gmail.com

# SMTP 密码
# SMTP_PASSWORD=your-app-password

# 发件人邮箱
# SMTP_FROM_EMAIL=noreply@yourdomain.com

# ====================
# 限流配置
# ====================

# API 请求限流 (每分钟)
# API_RATE_LIMIT_PER_MINUTE=100

# 登录尝试限制 (每 15 分钟)
# LOGIN_RATE_LIMIT_PER_15MIN=5

# 文件上传限流 (每分钟)
# UPLOAD_RATE_LIMIT_PER_MINUTE=10

# ====================
# AI 服务配置
# ====================

# OpenAI API Key (可选)
# OPENAI_API_KEY=sk-...

# Anthropic API Key (可选)
# ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini API Key (可选)
# GEMINI_API_KEY=your-gemini-key

# SiliconFlow API Key (可选)
# SILICONFLOW_API_KEY=sk-...

# 默认 LLM 提供商
# DEFAULT_LLM_PROVIDER=siliconflow

# ====================
# 媒体处理配置
# ====================

# 最大图片大小 (字节，默认 10MB)
# MAX_IMAGE_SIZE=10485760

# 最大视频大小 (字节，默认 100MB)
# MAX_VIDEO_SIZE=104857600

# 最大文件大小 (字节，默认 50MB)
# MAX_FILE_SIZE=52428800

# 是否启用病毒扫描
# VIRUS_SCAN_ENABLED=true

# ClamAV 扫描路径 (Linux/Unix)
# CLAMAV_PATH=/usr/bin/clamscan

# ====================
# WebSocket 配置
# ====================

# 心跳间隔 (秒)
# WS_HEARTBEAT_INTERVAL=30

# 连接超时 (秒)
# WS_TIMEOUT=300

# 最大连接数 (每用户)
# WS_MAX_CONNECTIONS_PER_USER=5

# ====================
# 数据库连接池配置
# ====================

# 最大连接数
# DB_MAX_CONNECTIONS=10

# 最小空闲连接数
# DB_MIN_IDLE_CONNECTIONS=2

# 连接超时 (秒)
# DB_CONNECT_TIMEOUT=30

# ====================
# 监控配置
# ====================

# 是否启用 Prometheus 指标
# METRICS_ENABLED=true

# 指标端口
# METRICS_PORT=9090

# 健康检查端口
# HEALTH_CHECK_PORT=8081